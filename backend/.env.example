# Postgres connection
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=event_management

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# JWT signing. Required - the app refuses to start without it.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of origins allowed to call this API (CORS).
# In production this must be your real frontend domain(s), never "*".
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dev/test only - include the password-reset token directly in the API
# response so the flow is testable without a real email service wired up.
# Leave unset (or "false") in production.
EXPOSE_PASSWORD_RESET_TOKEN=false

# Optional: error monitoring (https://sentry.io). Leave blank to disable.
SENTRY_DSN=
